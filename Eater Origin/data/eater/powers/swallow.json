    "assfgd": {
        "type": "origins:active_self",
        "key": {
            "key": "key.origins.primary_active"
        },
        "cooldown": 1000,
        "condition": {
            "type": "origins:and",
            "conditions": [{
                    "type": "origins:resource",
                    "compare_to": 0,
                    "comparison": "==",
                    "resource": "eater:swallow_hasfood"
                },
                {
                    "type": "origins:raycast",
                    "distance": 3,
                    "block": false,
                    "entity": true,
                    "shape_type": "collider",
                    "fluid_handling": "any",
                    "match_bientity_condition": {
                        "type": "origins:target_condition",
                        "condition": {
                            "type": "origins:and",
                            "conditions": [{
                                "type": "origins:entity_type",
                                "entity_type": "minecraft:creeper"
                            }]
                        }
                    }

                }
            ]
        },
        "hud_render": {
            "should_render": true,
            "bar_index": 14,
            "sprite_location": "origins:textures/gui/community/spiderkolo/resource_bar_01.png"
        },
        "entity_action": {
            "type": "origins:raycast",
            "distance": 3,
            "block": false,
            "entity": true,
            "shape_type": "collider",
            "fluid_handling": "any",
            "bientity_action": {
                "type": "origins:and",
                "actions": [{
                        "type": "origins:target_action",
                        "action": {
                            "type": "origins:heal",
                            "amount": -500
                        }
                    },
                    {
                        "type": "origins:actor_action",
                        "action": {
                            "type": "origins:change_resource",
                            "change": 1,
                            "operation": "set",
                            "resource": "eater:swallow_hasfood"
                        }
                    }
                ]
            },
            "command_along_ray": "particle minecraft:cloud",
            "command_step": 0.25,
            "command_along_ray_only_on_hit": true

        }
    },

