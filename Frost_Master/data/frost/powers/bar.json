{
    "name": "§b§nFrost Bar",
    "description": "§b§ Bar that most of your abilities use",
    "type": "origins:multiple",
    "snow": {
        "type": "origins:active_self",
        "key": {
            "key": "key.loadToolbarActivator",
            "continuous": true
        },
        "entity_action": {
            "type": "origins:and",
            "actions": [{
                    "type": "origins:equipped_item_action",
                    "equipment_slot": "mainhand",
                    "action": {
                        "type": "origins:consume",
                        "amount": 1
                    }
                },
                {
                    "type": "origins:change_resource",
                    "resource": "*:*_bar",
                    "change": 5
                }
            ]
        },
        "condition": {
            "type": "origins:and",
            "conditions": [{
                    "type": "origins:equipped_item",
                    "equipment_slot": "mainhand",
                    "item_condition": {
                        "type": "origins:ingredient",
                        "ingredient": {
                            "item": "minecraft:snow_block"
                        }
                    }
                },
                {
                    "type": "origins:resource",
                    "resource": "*:*_bar",
                    "comparison": "!=",
                    "compare_to": 150

                }
            ]
        }

    },
    "give": {
        "type": "origins:action_over_time",
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "*:*_bar",
            "change": 1
        },
        "interval": 20,
        "condition": {
    "type": "origins:fluid_height",
    "inverted":true,
    "fluid": "minecraft:water",
    "comparison": "==",
    "compare_to": 0
}
},
