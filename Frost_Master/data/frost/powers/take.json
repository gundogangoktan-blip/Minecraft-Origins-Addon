{
    "name": "Ice touch",
    "description": "You can carry ice",
    "type":"origins:multiple",
    "ice":{
    "type": "origins:action_on_block_break",
    "block_action": {
        "type":"origins:and",
        "actions": [
            {
        "type": "origins:execute_command",
        "command": "summon minecraft:item ~ ~ ~ {Item:{id:\"minecraft:ice\",Count:1}}"
            },
            {
                "type": "origins:set_block",
                "block": "minecraft:air"
            }
    ]
    },
    "block_condition": {
       
        "type": "origins:block",
        "block": "minecraft:ice"
        
    },
    "only_when_harvested": false
},
