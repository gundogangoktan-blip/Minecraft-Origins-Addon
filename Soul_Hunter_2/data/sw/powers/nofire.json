        "type":"origins:change_resource",
        "resource":"*:*_bar",
        "change": 1
    },
    "interval": 10,
    "condition": {
        "type": "origins:fluid_height",
        "inverted":true,
        "fluid": "minecraft:lava",
        "comparison": "==",
        "compare_to": 0
        }
},
"decrease":{
    "type":"origins:action_over_time",
    "entity_action": {
        "type":"origins:change_resource",
        "resource":"*:*_bar",
        "change": -1
    },
    "interval": 10,
    "condition": {
        "type": "origins:fluid_height",
        "fluid": "minecraft:lava",
        "comparison": "==",
        "compare_to": 0
        }
},
    "badges":[
    {
        "type": "origins:tooltip",
        "sprite": "minecraft:textures/block/dead_bush.png",
