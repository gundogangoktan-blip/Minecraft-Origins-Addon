            "name": "lava"
            },
            {
                "type": "origins:name",
                "name": "lava.player"
            }
    ]
    },
    "condition": {
        "type":"origins:and",
        "conditions":[
            {
        "type": "origins:resource",
        "resource": "sw:upgrade",
        "comparison": ">",
        "compare_to": 3
            },
            {   
            "type":"origins:resource",
            "resource":"*:*_bar",
            "comparison": "!=",
            "compare_to": 10
            }
        ]
    }
},
"bar":{
    "type":"origins:resource",
    "max": 10,
    "min": 0
},
"increase":{
    "type":"origins:action_over_time",
