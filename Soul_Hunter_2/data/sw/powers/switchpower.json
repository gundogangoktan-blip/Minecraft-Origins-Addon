                        {
                            "condition": {
                                "type": "origins:resource",
                                "resource": "*:*_res",
                                "comparison": "==",
                                "compare_to": 1
                            },
                            "action": {
                                "type": "origins:execute_command",
                                "command": "title @s actionbar {\"text\":\"I will command the anchored\",\"color\":\"aqua\",\"italic\":true}"
                            }
                        },
                        {
                            "condition": {
                                "type": "origins:resource",
                                "resource": "*:*_res",
                                "comparison": "==",
