                            }
                        },
                        {
                            "condition": {
                                "type": "origins:resource",
                                "resource": "*:*_res",
                                "comparison": "==",
                                "compare_to": 4
                            },
                            
                                "action": {
                                    "type": "origins:execute_command",
                                    "command": "title @s actionbar {\"text\":\"I will consume souls\",\"color\":\"aqua\",\"italic\":true}"
                                }
                            
                        },
                        {
                            "condition": {
                                "type":"origins:and",
                                "conditions": [
                                    {
                                "type": "origins:resource",
                                "resource": "*:*_res",
                                "comparison": "==",
                                "compare_to": 5
                                    },
                                    {
                                        "type": "origins:resource",
                                        "resource": "sw:upgrade",
                                        "comparison": ">",
                                        "compare_to": 1
                                    }
                                ]
                            },
                            "action": {
                                "type": "origins:execute_command",
                                "command": "title @s actionbar {\"text\":\"I will summon a skeleton horse\",\"color\":\"aqua\",\"italic\":true}"
                            }
                        },
                        {
                            "condition": {
                                "type":"origins:and",
                                "conditions": [
                                    {
                                "type": "origins:resource",
                                "resource": "*:*_res",
                                "comparison": "==",
                                "compare_to": 5
                                    },
                                    {
                                        "type": "origins:resource",
                                        "resource": "sw:upgrade",
                                        "comparison": "<=",
                                        "compare_to": 1
                                    }
                                ]
                            },
                            "action": {
                                "type": "origins:execute_command",
                                "command": "title @s actionbar {\"text\":\"I did not unlock this ability\",\"color\":\"aqua\",\"italic\":true}"
                            }
                        },
                        {
                            "condition": {
                                "type":"origins:and",
                                "conditions": [
                                    {
                                "type": "origins:resource",
                                "resource": "*:*_res",
                                "comparison": "==",
                                "compare_to": 3
                                    },
                                    
                                    {
                                            "type": "origins:power_active",
                                            "inverted": true,
                                            "power": "sw:callback2_toggle"
                                    }
                                    
                                ]
                            },
                            "action": {
                                "type": "origins:execute_command",
                                "command": "title @s actionbar {\"text\":\"I will call the anchored back\",\"color\":\"aqua\",\"italic\":true}"
                            }
                        },
                        {
                            "condition": {
                                "type":"origins:and",
                                "conditions": [
                                    {
                                "type": "origins:resource",
                                "resource": "*:*_res",
                                "comparison": "==",
                                "compare_to": 3
                                    },
                                    {
                                            "type": "origins:power_active",
                                            "power": "sw:callback2_toggle"
                                    }
                                    
                                ]
                            },
                            "action": {
                                "type": "origins:execute_command",
                                "command": "title @s actionbar {\"text\":\"I will stop calling the anchored back\",\"color\":\"aqua\",\"italic\":true}"
                            }
                        }
                    ]
                }
            ]
        }
    },
