{
    "type": "origins:multiple",
    "name": "Gunpowder Mastery",
    "description": "You can explode TNT instantly, and TNT Minecarts, without a flint and steel. TNT Minecarts set off in this way will travel forward until they hit a tall barrier, or an entity.",
    "set_off_tnt": {
        "type": "origins:action_on_block_use",
        "block_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:set_block",
                    "block": "minecraft:air" 
                },
                {
                    "type": "origins:execute_command",
                    "command": "summon minecraft:tnt ~ ~ ~ {Fuse:0s}"
                }
            ]
        },
        "block_condition": {
            "type": "origins:block",
            "block": "minecraft:tnt"
        },
        "item_condition": {
            "type": "origins:ingredient",
            "ingredient": {
                "item": "minecraft:flint_and_steel"
            },
            "inverted": true
        }
    },
    "set_off_tnt_minecart": {
        "type": "origins:active_self",
        "entity_action": {
            "type": "origins:raycast",
            "distance": 5,
            "block": false,
            "entity": true,
            "shape_type": "outline",
            "fluid_handling": "any",
            "bientity_action": {
                "type": "origins:target_action",
                "action": {
                    "type": "origins:execute_command",
                    "command": "function miner:tnt_minecart/start_ride"
                }
            }
        },
        "key": {
            "key": "key.use"
        },
        "cooldown": 1,
        "hud_render": {
            "should_render": false
        }
    }
}