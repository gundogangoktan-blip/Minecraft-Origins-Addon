{
    "name": "Craft Mobs",
    "description": "You can craft things to summon some mobs",
    "type": "origins:multiple",
    "1": {
        "type": "origins:recipe",
        "recipe": {
            "id": "husk",
            "type": "minecraft:crafting_shaped",
            "pattern": [
                " # ",
                "#/#",
                " # "
            ],
            "key": {
                "#": {
                    "item": "minecraft:rotten_flesh"
                },
                "/": {
                    "item": "minecraft:egg"
                }
            },
            "result": {
                "item": "minecraft:husk_spawn_egg",
                "count": 1
            }
        }
    },
    "condition": {
        "type": "origins:and",
        "conditions": [{
                "type": "origins:power_active",
                "power": "sw:toggle"
            },
            {
                "type": "origins:resource",
                "resource": "sw:upgrade",
                "comparison": "==",
                "compare_to": 1
            }
        ]
    },
