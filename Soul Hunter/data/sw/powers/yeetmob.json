{
  "name": "Yeet mob",
  "description": "You can carry and yeet mobs",
  "type": "origins:multiple",
  "pickup": {
    "type": "origins:action_on_entity_use",
    "bientity_action": {
      "type": "origins:invert",
      "action": {
        "type": "origins:mount"
      }
    },
    "condition": {
      "type": "origins:and",
      "conditions": [{
          "type": "origins:sneaking"
        },
        {
          "type": "origins:passenger",
          "inverted": true
        },
        {
          "type": "origins:equipped_item",
          "equipment_slot": "mainhand",
          "item_condition": {
            "type": "origins:empty"
          }
        }
      ]
    }
  },
  "drop": {
    "type": "origins:active_self",
    "cooldown": 1,
    "hud_render": {
      "should_render": false
    },
    "entity_action": {
      "type": "origins:passenger_action",
      "action": {
        "type": "origins:dismount"
      }
    },
    "key": {
      "key": "key.sneak"
    }
  },
  "throw": {
    "type": "origins:action_on_entity_use",
    "bientity_action": {
      "type": "origins:and",
      "actions": [{
          "type": "origins:target_action",
          "action": {
            "type": "origins:dismount"
          }
        },
        {
          "type": "origins:add_velocity",
          "z": 0.25,
          "y": -1
        }
      ]
    },
    "bientity_condition": {
      "type": "origins:invert",
      "condition": {
        "type": "origins:riding"
      }
    },
    "condition": {
      "type": "origins:equipped_item",
      "equipment_slot": "mainhand",
      "item_condition": {
        "type": "origins:empty"
      }
    }
  },
  "chicken": {
    "type": "origins:modify_falling",
    "velocity": 0.008,
    "condition": {
      "type": "origins:passenger",
      "bientity_condition": {
        "type": "origins:actor_condition",
        "condition": {
          "type": "origins:entity_type",
          "entity_type": "minecraft:chicken"
        }
      }
    }
  }
}